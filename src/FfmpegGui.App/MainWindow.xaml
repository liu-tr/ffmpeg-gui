<Window x:Class="FfmpegGui.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FfmpegGui.App"
        mc:Ignorable="d"
        Title="FFmpeg GUI Tool"
        Height="840"
        Width="1220"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FilePathTextBox"
                     Grid.Column="0"
                     Height="32"
                     Margin="0,0,8,0"
                     VerticalContentAlignment="Center"
                     IsReadOnly="True"
                     Text="请选择要分析的媒体文件" />

            <Button x:Name="SelectFileButton"
                    Grid.Column="1"
                    Width="110"
                    Height="32"
                    Content="选择文件"
                    Click="SelectFile_Click" />
        </Grid>

        <GroupBox Grid.Row="1"
                  Header="媒体信息"
                  Margin="0,12,0,12"
                  Padding="10">
            <UniformGrid Columns="4">
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="文件名" FontWeight="Bold" />
                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="封装格式" FontWeight="Bold" />
                    <TextBlock Text="{Binding FormatDisplay}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="时长" FontWeight="Bold" />
                    <TextBlock Text="{Binding DurationDisplay}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="总码率" FontWeight="Bold" />
                    <TextBlock Text="{Binding BitRateDisplay}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="文件大小" FontWeight="Bold" />
                    <TextBlock Text="{Binding SizeDisplay}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="视频流数量" FontWeight="Bold" />
                    <TextBlock Text="{Binding VideoStreams.Count}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="音频流数量" FontWeight="Bold" />
                    <TextBlock Text="{Binding AudioStreams.Count}" />
                </StackPanel>
            </UniformGrid>
        </GroupBox>

        <DataGrid x:Name="StreamsGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding Streams}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="60" />
                <DataGridTextColumn Header="类型" Binding="{Binding StreamTypeText}" Width="70" />
                <DataGridTextColumn Header="编码" Binding="{Binding CodecName}" Width="110" />
                <DataGridTextColumn Header="编码详情" Binding="{Binding CodecDisplay}" Width="220" />
                <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="90" />
                <DataGridTextColumn Header="分辨率" Binding="{Binding ResolutionText}" Width="100" />
                <DataGridTextColumn Header="帧率" Binding="{Binding FrameRateText}" Width="90" />
                <DataGridTextColumn Header="码率" Binding="{Binding BitRateText}" Width="100" />
                <DataGridTextColumn Header="采样率" Binding="{Binding SampleRateText}" Width="90" />
                <DataGridTextColumn Header="声道" Binding="{Binding ChannelsText}" Width="80" />
                <DataGridTextColumn Header="语言" Binding="{Binding LanguageText}" Width="70" />
                <DataGridTextColumn Header="默认" Binding="{Binding DefaultText}" Width="60" />
                <DataGridTextColumn Header="强制" Binding="{Binding ForcedText}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="3"
                  Header="输出设置"
                  Margin="0,12,0,0"
                  Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0">
                    <StackPanel Width="170" Margin="0,0,12,8">
                        <TextBlock Text="输出模式" FontWeight="Bold" />
                        <ComboBox x:Name="OutputModeComboBox"
                                  Height="30"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="OutputModeComboBox_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Width="190" Margin="0,0,12,8">
                        <TextBlock Text="封装格式" FontWeight="Bold" />
                        <ComboBox x:Name="ContainerComboBox"
                                  Height="30"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="ContainerComboBox_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Width="190" Margin="0,0,12,8">
                        <TextBlock Text="视频编码" FontWeight="Bold" />
                        <ComboBox x:Name="VideoCodecComboBox"
                                  Height="30"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="VideoCodecComboBox_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,0,12,8">
                        <TextBlock Text="视频质量" FontWeight="Bold" />
                        <ComboBox x:Name="VideoQualityComboBox"
                                  Height="30"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="VideoQualityComboBox_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,0,12,8">
                        <TextBlock Text="音频编码" FontWeight="Bold" />
                        <ComboBox x:Name="AudioCodecComboBox"
                                  Height="30"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="AudioCodecComboBox_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,12,8">
                        <TextBlock Text="音频码率" FontWeight="Bold" />
                        <ComboBox x:Name="AudioBitrateComboBox"
                                  Height="30"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="AudioBitrateComboBox_SelectionChanged" />
                    </StackPanel>
                </WrapPanel>

                <Grid Grid.Row="1" Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="输出文件夹"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="OutputFolderTextBox"
                             Grid.Column="1"
                             Height="30"
                             VerticalContentAlignment="Center"
                             TextChanged="OutputFolderTextBox_TextChanged" />
                    <Button x:Name="BrowseOutputFolderButton"
                            Grid.Column="2"
                            Width="100"
                            Height="30"
                            Margin="8,0,0,0"
                            Content="选择文件夹"
                            Click="BrowseOutputFolder_Click" />
                    <Button x:Name="StartButton"
                            Grid.Column="3"
                            Width="110"
                            Height="30"
                            Margin="8,0,0,0"
                            Content="开始转码"
                            Click="StartButton_Click" />
                    <Button x:Name="CancelButton"
                            Grid.Column="4"
                            Width="80"
                            Height="30"
                            Margin="8,0,0,0"
                            Content="取消"
                            IsEnabled="False"
                            Click="CancelButton_Click" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar x:Name="ProgressBar"
                                 Height="22"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0" />
                    <TextBlock x:Name="ProgressTextBlock"
                               Grid.Column="1"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Text="就绪" />
                </Grid>
            </Grid>
        </GroupBox>

        <StatusBar Grid.Row="4" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="正在检查 FFmpeg..." />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
